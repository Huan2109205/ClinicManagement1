
@{
    ViewBag.Title = "Khởi tạo Admin";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Khởi tạo Admin - ClinicManagement</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #eef2f7;
            font-family: Arial, sans-serif;
        }

        .setup-box {
            max-width: 480px;
            margin: 60px auto;
            padding: 30px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,.1);
        }

            .setup-box h3 {
                color: #1769aa;
                text-align: center;
                margin-bottom: 25px;
            }

        .btn-setup {
            width: 100%;
            background: #1769aa;
            color: white;
            padding: 11px;
        }
    </style>
</head>
<body>
    <div class="setup-box">
        <h3>KHỞI TẠO ADMIN</h3>

        <p class="text-muted text-center">
            Tạo tài khoản quản trị viên đầu tiên
        </p>

        @using (Html.BeginForm("SetupAdmin", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <div class="form-group mb-3">
                <label>Tên đăng nhập *</label>
                @Html.TextBox("username", null,
                         new { @class = "form-control", maxlength = "50" })
            </div>

            <div class="form-group mb-3">
                <label>Họ và tên *</label>
                @Html.TextBox("fullName", null,
                         new { @class = "form-control", maxlength = "100" })
            </div>

            <div class="form-group mb-3">
                <label>Email</label>
                @Html.TextBox("email", null,
                         new
                         {
                             @class = "form-control",
                             type = "email",
                             maxlength = "100"
                         })
            </div>

            <div class="form-group mb-3">
                <label>Mật khẩu *</label>
                @Html.Password("password", null,
                         new { @class = "form-control" })
                <small class="text-muted">
                    Mật khẩu tối thiểu 10 ký tự.
                </small>
            </div>

            <div class="form-group mb-3">
                <label>Xác nhận mật khẩu *</label>
                @Html.Password("confirmPassword", null,
                         new { @class = "form-control" })
            </div>

            <button type="submit" class="btn btn-setup">
                TẠO TÀI KHOẢN ADMIN
            </button>
        }
    </div>
</body>
</html>
