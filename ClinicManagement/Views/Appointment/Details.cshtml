@model ClinicManagement.Models.Appointment

@{
    ViewBag.Title = "Chi tiết lịch khám";
}

<h2>CHI TIẾT LỊCH KHÁM</h2>

<hr />

<div class="panel panel-info">
    <div class="panel-heading">
        <strong>Thông tin lịch khám</strong>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Mã lịch khám</dt>
            <dd>@Model.AppointmentCode</dd>

            <dt>Bệnh nhân</dt>
            <dd>
                @(Model.Patient != null
                ? Model.Patient.FullName : "Không xác định")
            </dd>

            <dt>Bác sĩ</dt>
            <dd>
                @(Model.Doctor != null
                ? Model.Doctor.FullName : "Không xác định")
            </dd>

            <dt>Ngày khám</dt>
            <dd>@Model.AppointmentDate.ToString("dd/MM/yyyy")</dd>

            <dt>Giờ khám</dt>
            <dd>@Model.AppointmentTime.ToString(@"hh\:mm")</dd>

            <dt>Lý do khám</dt>
            <dd>@Model.Reason</dd>

            <dt>Trạng thái</dt>
            <dd>@Model.Status</dd>

            <dt>Ghi chú</dt>
            <dd>@Model.Note</dd>
        </dl>
    </div>
</div>

@Html.ActionLink("Chỉnh sửa", "Edit",
    new { id = Model.AppointmentID },
    new { @class = "btn btn-warning" })

@Html.ActionLink("Quay lại danh sách", "Index",
    null, new { @class = "btn btn-default" })