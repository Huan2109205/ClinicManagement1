
@model ClinicManagement.Models.Doctor

@{
    ViewBag.Title = "Thêm bác sĩ";
}

<h2>Thêm bác sĩ mới</h2>

<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.DoctorCode, "Mã bác sĩ",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.DoctorCode,
                         new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.DoctorCode,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.FullName, "Họ và tên",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.FullName,
                         new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.FullName,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Chuyên khoa",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.SpecialtyID,
                         (IEnumerable<SelectListItem>)ViewBag.SpecialtyID,
                         "-- Chọn chuyên khoa --",
                         new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.SpecialtyID,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Phone, "Số điện thoại",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Phone,
                         new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Phone,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Email, "Email",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Email,
                         new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Email,
                         "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Address, "Địa chỉ",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Address,
                         new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IsActive, "Đang hoạt động",
                     new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.CheckBoxFor(m => m.IsActive)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Thêm bác sĩ"
                       class="btn btn-primary" />
                @Html.ActionLink("Quay lại", "Index",
                         null, new { @class = "btn btn-default" })
            </div>
        </div>

    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
