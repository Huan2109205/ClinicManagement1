
@model ClinicManagement.Models.Doctor

@{
    ViewBag.Title = "Chi tiết bác sĩ";
}

<h2>Thông tin chi tiết bác sĩ</h2>

<hr />

<dl class="dl-horizontal">
    <dt>Mã bác sĩ</dt>
    <dd>@Model.DoctorCode</dd>

    <dt>Họ và tên</dt>
    <dd>@Model.FullName</dd>

    <dt>Chuyên khoa</dt>
    <dd>
        @(Model.SpecialtyNavigation != null
            ? Model.SpecialtyNavigation.SpecialtyName
            : Model.Specialty)
    </dd>

    <dt>Số điện thoại</dt>
    <dd>@Model.Phone</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Địa chỉ</dt>
    <dd>@Model.Address</dd>

    <dt>Trạng thái</dt>
    <dd>
        @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
    </dd>
</dl>

<p>
    @Html.ActionLink("Sửa thông tin", "Edit",
            new { id = Model.DoctorID },
            new { @class = "btn btn-primary" })

    @Html.ActionLink("Quay lại", "Index",
            null, new { @class = "btn btn-default" })
</p>
