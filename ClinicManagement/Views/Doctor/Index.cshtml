
@model IEnumerable<ClinicManagement.Models.Doctor>

@{
    ViewBag.Title = "Quản lý bác sĩ";
}

<h2>Quản lý bác sĩ</h2>

<p>
    @Html.ActionLink(" + Thêm bác sĩ mới", "Create",
            null, new { @class = "btn btn-primary" })
</p>

@using (Html.BeginForm("Index", "Doctor", FormMethod.Get))
{
    <div class="form-inline" style="margin-bottom:20px;">
        <input type="text"
               name="keyword"
               value="@Request.QueryString["keyword"]"
               class="form-control"
               placeholder="Nhập mã, tên, chuyên khoa hoặc SĐT..." />

        <button type="submit" class="btn btn-info">
            Tìm kiếm
        </button>

        @Html.ActionLink("Làm mới", "Index",
                 null, new { @class = "btn btn-default" })
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>STT</th>
            <th>Mã bác sĩ</th>
            <th>Họ và tên</th>
            <th>Chuyên khoa</th>
            <th>Số điện thoại</th>
            <th>Email</th>
            <th>Trạng thái</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @{
            int stt = 1;
        }

        @foreach (var item in Model)
        {
            <tr>
                <td>@stt</td>
                <td>@item.DoctorCode</td>
                <td>@item.FullName</td>
                <td>
                    @(item.SpecialtyNavigation != null
                        ? item.SpecialtyNavigation.SpecialtyName
                        : item.Specialty)
                </td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="label label-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="label label-danger">Ngừng hoạt động</span>
                    }
                </td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details",
                             new { id = item.DoctorID }) |
                    @Html.ActionLink("Sửa", "Edit",
                             new { id = item.DoctorID }) |
                    @Html.ActionLink("Xóa", "Delete",
                             new { id = item.DoctorID })
                </td>
            </tr>

            stt++;
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-center text-muted">
        Không tìm thấy bác sĩ nào.
    </p>
}
