@model ClinicManagement.Models.Patient

@{
    ViewBag.Title = "Xóa bệnh nhân";
}

<h2>XÓA BỆNH NHÂN</h2>

<div class="alert alert-warning">
    <strong>Lưu ý!</strong>
    Bạn có chắc chắn muốn xóa bệnh nhân này không?
</div>

<div class="panel panel-danger">
    <div class="panel-heading">
        <strong>Thông tin bệnh nhân cần xóa</strong>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Mã bệnh nhân</dt>
            <dd>@Model.PatientCode</dd>

            <dt>Họ và tên</dt>
            <dd>@Model.FullName</dd>

            <dt>Ngày sinh</dt>
            <dd>
                @(Model.DateOfBirth.HasValue
                    ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy")
                    : "Chưa cập nhật")
            </dd>

            <dt>Giới tính</dt>
            <dd>@Model.Gender</dd>

            <dt>Số điện thoại</dt>
            <dd>@Model.Phone</dd>

            <dt>Email</dt>
            <dd>@Model.Email</dd>

            <dt>Địa chỉ</dt>
            <dd>@Model.Address</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm("Delete", "Patient",
    new { id = Model.PatientID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-danger"
            onclick="return confirm('Bạn chắc chắn muốn xóa bệnh nhân này?');">
        Xác nhận xóa
    </button>

    @Html.ActionLink("Hủy", "Index",
            null, new { @class = "btn btn-default" })
}