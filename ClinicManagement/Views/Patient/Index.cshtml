@model IEnumerable<ClinicManagement.Models.Patient>

@{
    ViewBag.Title = "Quản lý bệnh nhân";
}

<h2>QUẢN LÝ BỆNH NHÂN</h2>

<p>
    @Html.ActionLink("＋ Thêm bệnh nhân mới", "Create",
            null, new { @class = "btn btn-primary" })
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@using (Html.BeginForm("Index", "Patient", FormMethod.Get))
{
    <div class="form-inline" style="margin-bottom: 15px;">
        <input type="text"
               name="keyword"
               value="@ViewBag.Keyword"
               class="form-control"
               placeholder="Nhập mã, họ tên, SĐT hoặc email..." />

        <button type="submit" class="btn btn-success">
            Tìm kiếm
        </button>

        @Html.ActionLink("Làm mới", "Index",
                 null, new { @class = "btn btn-default" })
    </div>
}

<table class="table table-bordered table-striped">
    <tr>
        <th>Mã bệnh nhân</th>
        <th>Họ tên</th>
        <th>Ngày sinh</th>
        <th>Giới tính</th>
        <th>Số điện thoại</th>
        <th>Email</th>
        <th>Địa chỉ</th>
        <th>Chức năng</th>
    </tr>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.PatientCode</td>
                <td>@item.FullName</td>
                <td>
                    @(item.DateOfBirth.HasValue
                        ? item.DateOfBirth.Value.ToString("dd/MM/yyyy")
                        : "")
                </td>
                <td>@item.Gender</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Address</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details",
                             new { id = item.PatientID }) |

                    @Html.ActionLink("Sửa", "Edit",
                             new { id = item.PatientID }) |

                    @Html.ActionLink("Xóa", "Delete",
                             new { id = item.PatientID })
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="8" class="text-center">
                Không tìm thấy bệnh nhân nào.
            </td>
        </tr>
    }
</table>