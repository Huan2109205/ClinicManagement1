
@model ClinicManagement.Models.User

@{
    ViewBag.Title = "Thêm tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .user-create-page {
        padding: 25px 0;
    }

    .user-create-header {
        margin-bottom: 25px;
    }

        .user-create-header h2 {
            color: #263f5b;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .user-create-header p {
            color: #7b8794;
            margin-bottom: 0;
        }

    .user-form-card {
        background: #fff;
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0 4px 15px rgba(0,0,0,.07);
        max-width: 850px;
    }

    .form-section-title {
        font-size: 17px;
        font-weight: 700;
        color: #263f5b;
        border-bottom: 1px solid #e5eaf0;
        padding-bottom: 12px;
        margin-bottom: 22px;
    }

    .user-form-card label {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 8px;
    }

    .user-form-card .form-control,
    .user-form-card .form-select {
        min-height: 43px;
        border-radius: 7px;
    }

        .user-form-card .form-control:focus,
        .user-form-card .form-select:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 .15rem rgba(52,152,219,.15);
        }

    .form-hint {
        font-size: 12px;
        color: #7b8794;
        margin-top: 6px;
    }

    .doctor-section {
        background: #f1f7fc;
        border: 1px solid #d6eaf8;
        border-radius: 9px;
        padding: 18px;
        margin-top: 15px;
    }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper input {
            padding-right: 48px;
        }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #607080;
        cursor: pointer;
    }

    .user-form-actions {
        border-top: 1px solid #e5eaf0;
        margin-top: 25px;
        padding-top: 20px;
    }

    @@media(max-width:576px) {
        .user-form-card {
            padding: 18px;
        }
    }
</style>

<div class="container user-create-page">

    <!-- TIÊU ĐỀ -->
    <div class="user-create-header">
        <h2>THÊM TÀI KHOẢN MỚI</h2>
        <p>Tạo tài khoản đăng nhập và thiết lập quyền sử dụng hệ thống.</p>
    </div>

    <!-- FORM -->
    <div class="user-form-card">

        @using (Html.BeginForm(
            "Create",
            "User",
            FormMethod.Post,
            new { id = "createUserForm" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                     false,
                     "Vui lòng kiểm tra các lỗi sau:",
                     new { @class = "alert alert-danger" }
                 )

            <div class="form-section-title">
                Thông tin đăng nhập
            </div>

            <!-- TÊN ĐĂNG NHẬP -->
            <div class="form-group mb-3">
                @Html.LabelFor(
                         m => m.Username,
                         "Tên đăng nhập"
                     )

                @Html.TextBoxFor(
                         m => m.Username,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Nhập tên đăng nhập",
                             maxlength = "50",
                             autocomplete = "username",
                             required = "required"
                         }
                     )

                @Html.ValidationMessageFor(
                         m => m.Username,
                         "",
                         new { @class = "text-danger" }
                     )
            </div>

            <!-- MẬT KHẨU -->
            <div class="form-group mb-3">
                <label for="password">Mật khẩu</label>

                <div class="password-wrapper">
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           minlength="10"
                           maxlength="128"
                           required
                           autocomplete="new-password"
                           placeholder="Nhập mật khẩu tối thiểu 10 ký tự" />

                    <button type="button"
                            class="password-toggle"
                            id="togglePassword"
                            title="Hiện hoặc ẩn mật khẩu">
                        Hiện
                    </button>
                </div>

                @Html.ValidationMessage(
                         "Password",
                         "",
                         new { @class = "text-danger" }
                     )

                <div class="form-hint">
                    Mật khẩu phải có ít nhất 10 ký tự.
                </div>
            </div>

            <div class="form-section-title mt-4">
                Thông tin cá nhân
            </div>

            <!-- HỌ TÊN -->
            <div class="form-group mb-3">
                @Html.LabelFor(
                         m => m.FullName,
                         "Họ và tên"
                     )

                @Html.TextBoxFor(
                         m => m.FullName,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Nhập họ và tên",
                             maxlength = "100"
                         }
                     )

                @Html.ValidationMessageFor(
                         m => m.FullName,
                         "",
                         new { @class = "text-danger" }
                     )
            </div>

            <!-- EMAIL -->
            <div class="form-group mb-3">
                @Html.LabelFor(
                         m => m.Email,
                         "Địa chỉ Email"
                     )

                @Html.TextBoxFor(
                         m => m.Email,
                         new
                         {
                             @class = "form-control",
                             type = "email",
                             placeholder = "example@gmail.com",
                             maxlength = "100"
                         }
                     )

                @Html.ValidationMessageFor(
                         m => m.Email,
                         "",
                         new { @class = "text-danger" }
                     )
            </div>

            <div class="form-section-title mt-4">
                Phân quyền tài khoản
            </div>

            <!-- QUYỀN -->
            <div class="form-group mb-3">
                @Html.LabelFor(
                         m => m.RoleID,
                         "Vai trò người dùng"
                     )

                @Html.DropDownList(
                         "RoleID",
                         (SelectList)ViewBag.RoleID,
                         "-- Chọn quyền --",
                         new
                         {
                             @class = "form-select",
                             id = "RoleID",
                             required = "required"
                         }
                     )

                @Html.ValidationMessageFor(
                         m => m.RoleID,
                         "",
                         new { @class = "text-danger" }
                     )

                <div class="form-hint">
                    Chọn quyền phù hợp với nhiệm vụ của người sử dụng.
                </div>
            </div>

            <!-- BÁC SĨ -->
            <div class="doctor-section"
                 id="doctorSection"
                 style="display:none;">

                <div class="form-group mb-2">
                    <label for="DoctorID">
                        Hồ sơ bác sĩ liên kết
                    </label>

                    @Html.DropDownListFor(
                             m => m.DoctorID,
                             (SelectList)ViewBag.DoctorID,
                             "-- Chọn bác sĩ --",
                             new
                             {
                                 @class = "form-select",
                                 id = "DoctorID"
                             }
                         )

                    @Html.ValidationMessageFor(
                             m => m.DoctorID,
                             "",
                             new { @class = "text-danger" }
                         )

                    <div class="form-hint">
                        Tài khoản có quyền Doctor bắt buộc phải liên kết
                        với một hồ sơ bác sĩ đang hoạt động.
                    </div>
                </div>
            </div>

            <!-- NÚT -->
            <div class="user-form-actions d-flex flex-wrap">

                <button type="submit"
                        class="btn btn-primary mr-2 mb-2">
                    Thêm tài khoản
                </button>

                @Html.ActionLink(
                         "Quay lại",
                         "Index",
                         "User",
                         null,
                         new { @class = "btn btn-secondary mb-2" }
                     )

            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>document.addEventListener("DOMContentLoaded", function () {

            var roleSelect = document.getElementById("RoleID");
            var doctorSection = document.getElementById("doctorSection");
            var doctorSelect = document.getElementById("DoctorID");

            function updateDoctorSection() {
                if (!roleSelect || !doctorSection) return;

                var selectedOption =
                    roleSelect.options[roleSelect.selectedIndex];

                var roleName = selectedOption
                    ? selectedOption.text.trim()
                    : "";

                var isDoctor =
                    roleName.toLowerCase() === "doctor";

                doctorSection.style.display =
                    isDoctor ? "block" : "none";

                if (doctorSelect) {
                    doctorSelect.required = isDoctor;

                    if (!isDoctor) {
                        doctorSelect.value = "";
                    }
                }
            }

            if (roleSelect) {
                roleSelect.addEventListener(
                    "change",
                    updateDoctorSection
                );

                updateDoctorSection();
            }

            // HIỆN / ẨN MẬT KHẨU
            var passwordInput =
                document.getElementById("password");

            var togglePassword =
                document.getElementById("togglePassword");

            if (passwordInput && togglePassword) {
                togglePassword.addEventListener("click", function () {

                    var isPassword =
                        passwordInput.type === "password";

                    passwordInput.type =
                        isPassword ? "text" : "password";

                    togglePassword.textContent =
                        isPassword ? "Ẩn" : "Hiện";
                });
            }
        });</script>
}
