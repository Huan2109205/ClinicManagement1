
@model ClinicManagement.Models.User

@{
    ViewBag.Title = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .reset-page {
        padding: 30px 0;
    }

    .reset-header {
        margin-bottom: 25px;
    }

        .reset-header h2 {
            color: #263f5b;
            font-weight: 700;
        }

        .reset-header p {
            color: #7b8794;
            margin-bottom: 0;
        }

    .reset-card {
        max-width: 650px;
        background: #fff;
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0 4px 15px rgba(0,0,0,.07);
    }

    .reset-section-title {
        color: #263f5b;
        font-weight: 700;
        font-size: 17px;
        border-bottom: 1px solid #e5eaf0;
        padding-bottom: 12px;
        margin-bottom: 20px;
    }

    .reset-card label {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 8px;
    }

    .reset-card .form-control {
        min-height: 44px;
        border-radius: 7px;
    }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper input {
            padding-right: 65px;
        }

    .password-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #2980b9;
        font-weight: 600;
        cursor: pointer;
    }

    .reset-hint {
        font-size: 12px;
        color: #7b8794;
        margin-top: 6px;
    }

    .reset-user-info {
        background: #eaf4fc;
        border: 1px solid #d6eaf8;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
    }

        .reset-user-info strong {
            color: #21618c;
        }

    .password-match-message {
        font-size: 13px;
        margin-top: 6px;
    }

    .reset-actions {
        border-top: 1px solid #e5eaf0;
        padding-top: 20px;
        margin-top: 25px;
    }

    @@media(max-width:576px) {
        .reset-card {
            padding: 18px;
        }
    }
</style>

<div class="container reset-page">

    <!-- TIÊU ĐỀ -->
    <div class="reset-header">
        <h2>ĐẶT LẠI MẬT KHẨU</h2>
        <p>Thiết lập mật khẩu mới cho tài khoản người dùng.</p>
    </div>

    <div class="reset-card">

        <!-- THÔNG TIN TÀI KHOẢN -->
        <div class="reset-user-info">
            <div class="mb-1">
                Bạn đang đặt lại mật khẩu cho tài khoản:
            </div>

            <strong>@Model.Username</strong>

            <div class="text-muted mt-1">
                Mã tài khoản: #@Model.UserID
            </div>
        </div>

        @using (Html.BeginForm(
            "ResetPassword",
            "User",
            FormMethod.Post,
            new { id = "resetPasswordForm" }))
        {
            @Html.AntiForgeryToken()

            @Html.Hidden("UserID", Model.UserID)

            @Html.ValidationSummary(
                     false,
                     "Vui lòng kiểm tra các thông tin sau:",
                     new { @class = "alert alert-danger" }
                 )

            <div class="reset-section-title">
                Thông tin mật khẩu mới
            </div>

            <!-- MẬT KHẨU MỚI -->
            <div class="form-group mb-4">

                <label for="newPassword">
                    Mật khẩu mới
                </label>

                <div class="password-wrapper">
                    <input type="password"
                           id="newPassword"
                           name="newPassword"
                           class="form-control"
                           minlength="10"
                           maxlength="128"
                           required
                           autocomplete="new-password"
                           placeholder="Nhập mật khẩu mới" />

                    <button type="button"
                            class="password-toggle"
                            data-target="newPassword">
                        Hiện
                    </button>
                </div>

                @Html.ValidationMessage(
                         "newPassword",
                         "",
                         new { @class = "text-danger" }
                     )

                <div class="reset-hint">
                    Mật khẩu phải có ít nhất 10 ký tự.
                </div>

            </div>

            <!-- XÁC NHẬN MẬT KHẨU -->
            <div class="form-group mb-3">

                <label for="confirmPassword">
                    Xác nhận mật khẩu mới
                </label>

                <div class="password-wrapper">
                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="form-control"
                           minlength="10"
                           maxlength="128"
                           required
                           autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu mới" />

                    <button type="button"
                            class="password-toggle"
                            data-target="confirmPassword">
                        Hiện
                    </button>
                </div>

                @Html.ValidationMessage(
                         "confirmPassword",
                         "",
                         new { @class = "text-danger" }
                     )

                <div id="passwordMatchMessage"
                     class="password-match-message"></div>

            </div>

            <!-- NÚT -->
            <div class="reset-actions d-flex flex-wrap">

                <button type="submit"
                        class="btn btn-primary mr-2 mb-2">
                    Lưu mật khẩu mới
                </button>

                @Html.ActionLink(
                         "Quay lại",
                         "Index",
                         "User",
                         null,
                         new { @class = "btn btn-secondary mb-2" }
                     )

            </div>
        }

    </div>
</div>

@section scripts {
    <script>document.addEventListener("DOMContentLoaded", function () {

            var newPassword =
                document.getElementById("newPassword");

            var confirmPassword =
                document.getElementById("confirmPassword");

            var message =
                document.getElementById("passwordMatchMessage");

            var form =
                document.getElementById("resetPasswordForm");

            // HIỆN / ẨN MẬT KHẨU
            var toggleButtons =
                document.querySelectorAll(".password-toggle");

            toggleButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    var targetId =
                        button.getAttribute("data-target");

                    var input =
                        document.getElementById(targetId);

                    if (!input) return;

                    var isPassword =
                        input.type === "password";

                    input.type =
                        isPassword ? "text" : "password";

                    button.textContent =
                        isPassword ? "Ẩn" : "Hiện";
                });
            });

            // KIỂM TRA HAI MẬT KHẨU
            function checkPasswordMatch() {

                if (!newPassword.value ||
                    !confirmPassword.value) {

                    message.textContent = "";
                    message.style.color = "";
                    return true;
                }

                if (newPassword.value === confirmPassword.value) {

                    message.textContent =
                        "Hai mật khẩu khớp nhau.";

                    message.style.color = "#196b3b";

                    return true;
                }

                message.textContent =
                    "Hai mật khẩu không khớp.";

                message.style.color = "#c0392b";

                return false;
            }

            newPassword.addEventListener(
                "input",
                checkPasswordMatch
            );

            confirmPassword.addEventListener(
                "input",
                checkPasswordMatch
            );

            // KHÔNG GỬI FORM NẾU MẬT KHẨU KHÔNG KHỚP
            form.addEventListener("submit", function (event) {

                if (newPassword.value.length < 10) {

                    event.preventDefault();

                    alert("Mật khẩu phải có ít nhất 10 ký tự.");

                    newPassword.focus();

                    return;
                }

                if (!checkPasswordMatch()) {

                    event.preventDefault();

                    confirmPassword.focus();
                }
            });
        });</script>
}
